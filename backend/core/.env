# Development Environment
DEBUG=False
NODE_ENV=development

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database
DATABASE_URL=sqlite+aiosqlite:///./backend/core/my_agent.db
MONGO_URL=mongodb://localhost:27017/my_agent
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=my-agent-dev-secret-key-change-in-production-32chars
JWT_EXPIRATION_HOURS=24

# Logging
LOG_LEVEL=INFO
