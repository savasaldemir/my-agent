# Development Environment
DEBUG=True
NODE_ENV=development

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/my_agent
MONGO_URL=mongodb://mongo:27017/my_agent
REDIS_URL=redis://redis:6379

# Security
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24

# Logging
LOG_LEVEL=DEBUG
