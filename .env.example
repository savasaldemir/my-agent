# API Configuration
API_PORT=3000
API_HOST=localhost
NODE_ENV=development

# Python Core
PYTHON_PORT=8000
PYTHON_HOST=localhost

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/my-agent
MONGO_URL=mongodb://localhost:27017/my-agent
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=24h

# System
LOG_LEVEL=info
DEBUG=false

# Service URLs
CORE_SERVICE_URL=http://localhost:8000
API_GATEWAY_URL=http://localhost:3000
WEB_UI_URL=http://localhost:5173
